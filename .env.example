# Turso Cloud Database credentials
# Get these from https://turso.tech → your database → "Show connect credentials"
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_long_auth_token_here
MEDIA_WRITE_CONCURRENCY=4
MAX_IMAGE_UPLOAD_BYTES=2097152
MAX_AUDIO_UPLOAD_BYTES=2097152
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=WAMS <no-reply@your-verified-domain.example>